<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-rename-name-to-description" author="damlaSub">

        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="tasks" columnName="name" schemaName="donezo_schema"/>
                <not>
                    <columnExists tableName="tasks" columnName="description" schemaName="donezo_schema"/>
                </not>
            </and>
        </preConditions>

        <renameColumn
                tableName="tasks"
                schemaName="donezo_schema"
                oldColumnName="name"
                newColumnName="description"
                columnDataType="varchar(255)" />
    </changeSet>

</databaseChangeLog>
